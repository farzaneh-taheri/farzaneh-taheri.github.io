---
import Layout from '../layouts/Layout.astro';
---
<Layout title="درخواست شما ثبت شد" description="از ارتباط شما با مجموعه فرطا سپاسگزاریم. اطلاعات ثبت‌شده توسط تیم ما بررسی شده و از طریق روش ارتباطی انتخاب‌شده با شما هماهنگ خواهیم کرد." noindex>

    <section>
        <div class="container" style="max-width:640px; text-align:center;">
            <div class="card spot reveal" data-delay="0" style="padding:40px 28px; align-items:center;">
                <div class="icon-wrap" style="width:60px; height:60px;"><svg class="ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"/></svg></div>
                <h1 class="reveal">درخواست شما با موفقیت ثبت شد</h1>
                <p class="lead reveal" style="margin:12px auto;">
                    از ارتباط شما با مجموعه فرطا سپاسگزاریم. اطلاعات ثبت‌شده توسط تیم ما بررسی شده و از طریق روش ارتباطی انتخاب‌شده با شما هماهنگ خواهیم کرد.
                </p>
                <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:12px; margin-top:16px;">
                    <a href="/evidence/" class="btn btn-primary">مشاهده نمونه گزارش‌های فرطا <svg class="ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg></a>
                    <a href="/" class="btn btn-secondary">بازگشت به صفحه اصلی</a>
                </div>
            </div>
        </div>
    </section>
</Layout>
