---
import Layout from '../layouts/Layout.astro';
---
<Layout title="سیاست حریم خصوصی" description="اطلاعاتی که در فرم درخواست جلسه ثبت می‌کنید صرفاً جهت بررسی اولیه و تماس با شما استفاده می‌شود. فرطا هرگز در فرم‌های وب‌سایت درخواست رمز عبور یا دسترسی نمی‌کند.">

    <section>
        <div class="container" style="max-width:840px;">
            <span class="pill reveal">حفاظت از داده‌ها</span>
            <h1 class="reveal">سیاست حفظ حریم خصوصی در فرطا</h1>
            <div class="card spot reveal" data-delay="0" style="margin-top:20px; gap:14px;">
                <h3>۱. اطلاعات فرم‌های ارتباطی</h3>
                <p style="color:var(--color-ink);">اطلاعاتی که در فرم درخواست جلسه ثبت می‌کنید صرفاً جهت بررسی اولیه و تماس با شما استفاده می‌شود. فرطا هرگز در فرم‌های وب‌سایت درخواست رمز عبور یا دسترسی نمی‌کند.</p>
                <h3>۲. اصل حداقل دسترسی در اجرای پروژه‌ها</h3>
                <p style="color:var(--color-ink);">در پروژه‌های اجرایی، دسترسی صرفاً از طریق حساب کاربری جداگانه و موقت همراه با احراز هویت دو مرحله‌ای دریافت شده و حداکثر ظرف ۲۴ تا ۴۸ ساعت پس از تحویل کار به طور کامل حذف می‌گردد.</p>
            </div>
        </div>
    </section>
</Layout>
